#!/usr/bin/env bash
# Hook pre-commit : valide les ADR ajoutes ou modifies.
root=$(git rev-parse --show-toplevel)
mapfile -t staged < <(git diff --cached --name-only --diff-filter=AM | grep -E '^doc/adr/[0-9]{3}-.*\.md$' | grep -v '^doc/adr/000-')
[ "${#staged[@]}" -eq 0 ] && exit 0
exec "$root/scripts/check-adr.sh" "${staged[@]}"
